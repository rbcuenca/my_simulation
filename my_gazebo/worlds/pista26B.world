<?xml version="1.0"?>
<sdf version="1.4">
  <world name="pista26B">
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

  <!-- A global light source  -->
    <include>
      <uri>model://sun</uri>
      <pose> -1.0 2.0 1.0 0 0 0</pose>
    </include>

  <!-- Piso da sala - circuito  e Paredes da Sala -->
    <include>
      <uri>model://Floors/Pista24B</uri>
      <pose> 0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://Walls/entorno26B</uri>
      <pose> 0 0 0 0 0 0</pose>
    </include>

  <!-- Casa no lugar das caixas: entrada (-1.325, -0.55), saida (1.525, -0.55).
       Corredores livres de 0.76 a 0.80 m, salas e bifurcacoes; creeper nos fundos.
       A parede sul do entorno foi recuada de -3.425 para -5.6 m. -->
    <include>
      <uri>model://Walls/casa26B</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  <!-- creeper_verde_11 -->
    <include>
      <uri>model://Creepers/creeper_verde_11</uri>
      <pose> -1.15 -4.35 0 0 0 1.5707963</pose>
    </include>

  <!-- creeper_azul_11 -->
    <include>
      <uri>model://Creepers/creeper_azul_11</uri>
      <pose> -2.7 0.91 0 0 0 0</pose>
    </include>

  <!-- creeper_vermelho_11 -->
    <!-- <include>
      <uri>model://Creepers/creeper_vermelho_11</uri>
      <pose> -0.5 -1.5 0 0 0 0</pose>
    </include> -->
  <!-- creeper_verde_21-->
    <include>
      <uri>model://Creepers/creeper_azul_21</uri>
      <pose> -2.7 1.36 0 0 0 0</pose>
    </include>

  <!-- creeper_azul_21-->
    <include>
      <uri>model://Creepers/creeper_verde_21</uri>
      <pose> -2.7 1.12 0 0 0 0</pose>
    </include>

  <!-- Toten_100 -->
    <include>
      <uri>model://Creepers/toten_100</uri>
      <pose> -1.5 0.7 0 0 0 -3.1000450</pose>
    </include>

  <!-- Toten_150 -->
    <include>
      <uri>model://Creepers/toten_150</uri>
      <pose> 1.3 3.1 0 0 0 0</pose>
    </include>

  <!-- Toten_250 -->
    <include>
      <uri>model://Creepers/toten_250</uri>
      <pose> 1.8 0.7 0 0 0 -1.554625</pose>
    </include>

  <!-- fisica do mundo -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  <!-- posicao camera inicial -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0.2 -10.8 13.5 0 0.98 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>

</sdf>
