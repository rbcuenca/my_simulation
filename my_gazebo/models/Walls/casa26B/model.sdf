<?xml version="1.0"?>
<sdf version="1.6">
  <model name="casa26B">
    <static>true</static>
    <!--
    Mesma area da casa original: centros do entorno x=[-1.8,2], y=[-5.1,-0.55].
    Malha 4 x 5: passos 0.95 x 0.91 m, paredes de 0.15 m.
    Corredores livres: 0.80 m em x e 0.76 m em y, como no mapa labirinto.
    A/B/C/D = colunas de oeste para leste; 0..4 = linhas de norte para sul.
    Entrada A0, saida D0. Salas: A1+B1, A3+B3+A4+B4 (creeper), C1+D1+C2+D2.
    Percurso: A0-A1-A2-B2-B3-B4-C4-D4-D3-C3-C2-C1-C0-D0.
    Ramificacao de busca A1-B1-B0; sala leste com alternativas C1/D1/C2/D2.
-->
    <link name="lateral_oeste">
      <pose>-1.8 -2.825 0.375 0 0 0</pose>
